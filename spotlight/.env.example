# Copy to spotlight/.env (gitignored) and fill in. Restart `npx expo start` after a change.
# EXPO_PUBLIC_ variables are bundled into the app and are public. Only the Supabase
# URL and publishable key may use the prefix (CLAUDE.md). Never put a secret here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
